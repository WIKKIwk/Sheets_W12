# Docker Compose Environment Variables
# Copy this file to .env and update values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

DB_HOST=converter_db
DB_PORT=5432
DB_USER=user
DB_PASSWORD=password
DB_NAME=converter_db
DB_DSN=host=converter_db user=user password=password dbname=converter_db port=5432 sslmode=disable

# ============================================================================
# GO BACKEND CONFIGURATION
# ============================================================================

PORT=8080

# JWT Secret (MUST be at least 32 characters in production)
JWT_SECRET=your-development-jwt-secret-key-minimum-32-chars-long

# CORS Allowed Origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:8001,http://localhost:5173

# Internal API Secret for backend-to-backend communication
INTERNAL_API_SECRET=dev-internal-secret

# Gin Mode (debug, release, test)
GIN_MODE=debug

# ============================================================================
# REDIS CONFIGURATION
# ============================================================================

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ============================================================================
# ELIXIR BACKEND CONFIGURATION
# ============================================================================

# Secret key base for Phoenix (MUST be at least 64 characters)
ELIXIR_SECRET_KEY_BASE=dev-elixir-secret-base-minimum-64-chars-long-replace-in-production

# Phoenix host and port
PHX_HOST=localhost
PHX_PORT=4000

# Mix environment
MIX_ENV=dev

# ============================================================================
# AI CONFIGURATION (Optional)
# ============================================================================

# Users can set their own Gemini API keys via the UI
# This is a system-wide default (optional)
# GEMINI_API_KEY=your-gemini-api-key-here

# ============================================================================
# FRONTEND CONFIGURATION
# ============================================================================

# API Base URL
VITE_API_URL=http://localhost:8080
VITE_WS_URL=ws://localhost:4000

# ============================================================================
# EMAIL CONFIGURATION (Optional - for user invitations)
# ============================================================================

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@yourdomain.com
# SMTP_PASSWORD=your-smtp-password
# SMTP_FROM=W12C Sheets <noreply@yourdomain.com>

# ============================================================================
# SECURITY SETTINGS
# ============================================================================

# Rate limiting (requests per second)
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=3600

# Bcrypt cost (10-14 recommended, higher = slower but more secure)
BCRYPT_COST=10

# ============================================================================
# DEVELOPMENT SETTINGS
# ============================================================================

# Enable debug logging
DEBUG=true

# Hot reload for frontend
VITE_HMR=true

# ============================================================================
# BACKUP CONFIGURATION (Optional)
# ============================================================================

# Backup schedule (cron format)
# BACKUP_SCHEDULE=0 2 * * *  # Daily at 2 AM

# Backup retention in days
# BACKUP_RETENTION_DAYS=30

# ============================================================================
# NOTES
# ============================================================================

# 1. NEVER commit this file with real credentials to git
# 2. Use strong, random secrets in production
# 3. Generate secrets with: openssl rand -base64 64
# 4. See .env.production.example for production settings
